{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/urosj/graph-reflexive-coherence/specs/grc-v4-contract-schema.json",
  "title": "GRCV4 and GRC9V4 implementation-contract schemas",
  "schema_version": "grcv4-implementation-contract-schema-v1",
  "canonicalization": "RFC8785_JCS_over_I_JSON",
  "authority": "implementation_contract_not_scientific_evidence",
  "$defs": {
    "safe_integer": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "finite_number": {
      "type": "number"
    },
    "nonnegative_number": {
      "type": "number",
      "minimum": 0
    },
    "positive_number": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grcv4_params_id": {
      "type": "string",
      "pattern": "^grcv4-params-sha256:[0-9a-f]{64}$"
    },
    "grcv4_profile_id": {
      "type": "string",
      "pattern": "^grcv4-profile-sha256:[0-9a-f]{64}$"
    },
    "grcv4_profile_template_id": {
      "type": "string",
      "pattern": "^grcv4-profile-template-sha256:[0-9a-f]{64}$"
    },
    "grc9v4_params_id": {
      "type": "string",
      "pattern": "^grc9v4-params-sha256:[0-9a-f]{64}$"
    },
    "grc9v4_specialization_id": {
      "type": "string",
      "pattern": "^grc9v4-specialization-sha256:[0-9a-f]{64}$"
    },
    "grc9v4_model_id": {
      "type": "string",
      "pattern": "^grc9v4-model-sha256:[0-9a-f]{64}$"
    },
    "graph_id": {
      "type": "string",
      "pattern": "^grc-graph-sha256:[0-9a-f]{64}$"
    },
    "state_id": {
      "type": "string",
      "pattern": "^grcv4-state-sha256:[0-9a-f]{64}$"
    },
    "lifecycle_id": {
      "type": "string",
      "pattern": "^grcv4-lifecycle-sha256:[0-9a-f]{64}$"
    },
    "reset_id": {
      "type": "string",
      "pattern": "^grcv4-reset-sha256:[0-9a-f]{64}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^grc-event-sha256:[0-9a-f]{64}$"
    },
    "commit_id": {
      "type": "string",
      "pattern": "^grc-commit-sha256:[0-9a-f]{64}$"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^grc-receipt-sha256:[0-9a-f]{64}$"
    },
    "digest_reference": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*-sha256:[0-9a-f]{64}$"
    },
    "model_id": {
      "oneOf": [
        {"$ref": "#/$defs/grcv4_profile_id"},
        {"$ref": "#/$defs/grc9v4_model_id"}
      ]
    },
    "step_request": {
      "type": "object",
      "required": ["schema_version", "dt", "context_value", "boundary_input", "external_source"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-step-request-v1"},
        "dt": {"$ref": "#/$defs/nonnegative_number"},
        "context_value": {"type": "object"},
        "boundary_input": {"type": ["object", "null"]},
        "external_source": {"type": ["object", "null"]}
      }
    },
    "migration_policy": {
      "type": "object",
      "required": ["schema_version", "policy_id", "resource_policy_id", "target_readmission_policy_id"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-migration-policy-v1"},
        "policy_id": {"const": "typed_bidirectional_profile_migration_v1"},
        "resource_policy_id": {"const": "identity_resource_transport_v1"},
        "target_readmission_policy_id": {"const": "full_target_fail_closed_v1"}
      }
    },
    "history_event_policy": {
      "type": "object",
      "required": ["schema_version", "disposition", "source_history_digest", "target_initializer_id", "information_loss"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-history-event-policy-v1"},
        "disposition": {"enum": ["not_applicable", "exact_transport", "target_initializer", "whole_carrier_map", "whole_carrier_reset", "explicit_loss"]},
        "source_history_digest": {"oneOf": [{"$ref": "#/$defs/digest_reference"}, {"type": "null"}]},
        "target_initializer_id": {"type": ["string", "null"]},
        "information_loss": {"enum": ["none", "candidate_history_loss", "carrier_history_loss", "v4_surface_projection", "whole_state_delegate_crossing"]}
      }
    },
    "resource_event_map": {
      "type": "object",
      "required": ["schema_version", "policy_id", "source_vertex_ids", "target_vertex_ids", "row_major_coefficients"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-resource-event-map-v1"},
        "policy_id": {"type": "string", "minLength": 1},
        "source_vertex_ids": {"type": "array", "items": {"type": ["string", "integer"]}},
        "target_vertex_ids": {"type": "array", "items": {"type": ["string", "integer"]}},
        "row_major_coefficients": {"type": "array", "items": {"$ref": "#/$defs/nonnegative_number"}}
      }
    },
    "serialized_graph_payload": {
      "type": "object",
      "required": ["schema_version", "live_node_ids", "oriented_edges"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-serialized-graph-v1"},
        "live_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": ["string", "integer"]}},
        "oriented_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["edge_id", "tail_node_id", "head_node_id"],
            "additionalProperties": false,
            "properties": {
              "edge_id": {"type": "string", "minLength": 1},
              "tail_node_id": {"type": ["string", "integer"]},
              "head_node_id": {"type": ["string", "integer"]}
            }
          }
        }
      }
    },
    "migration_request": {
      "type": "object",
      "required": ["schema_version", "operation_id", "source_state_digest", "target_profile_id", "migration_policy", "history_policy", "target_context_value"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-migration-request-v1"},
        "operation_id": {"type": "string", "minLength": 1},
        "source_state_digest": {"$ref": "#/$defs/state_id"},
        "target_profile_id": {"$ref": "#/$defs/grcv4_profile_id"},
        "migration_policy": {"$ref": "#/$defs/migration_policy"},
        "history_policy": {"$ref": "#/$defs/history_event_policy"},
        "target_context_value": {"type": "object"}
      }
    },
    "mapped_topology_event_request": {
      "type": "object",
      "required": ["schema_version", "operation_id", "source_state_digest", "source_graph_digest", "target_graph", "target_profile_id", "resource_map", "history_policy", "metadata"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-mapped-topology-event-request-v1"},
        "operation_id": {"type": "string", "minLength": 1},
        "source_state_digest": {"$ref": "#/$defs/state_id"},
        "source_graph_digest": {"$ref": "#/$defs/graph_id"},
        "target_graph": {"$ref": "#/$defs/serialized_graph_payload"},
        "target_profile_id": {"$ref": "#/$defs/grcv4_profile_id"},
        "resource_map": {"$ref": "#/$defs/resource_event_map"},
        "history_policy": {"$ref": "#/$defs/history_event_policy"},
        "metadata": {"type": "object"}
      }
    },
    "common_params": {
      "type": "object",
      "required": [
        "schema_version", "differential_backend_id", "boundary_policy_id",
        "measure_profile_id", "context_contract_id", "units_id", "gauge_id",
        "normalization_id", "domain_id", "default_step_request"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-common-params-v1"},
        "differential_backend_id": {"type": "string", "minLength": 1},
        "boundary_policy_id": {"type": "string", "minLength": 1},
        "measure_profile_id": {"type": "string", "minLength": 1},
        "context_contract_id": {"type": "string", "minLength": 1},
        "units_id": {"type": "string", "minLength": 1},
        "gauge_id": {"type": "string", "minLength": 1},
        "normalization_id": {"type": "string", "minLength": 1},
        "domain_id": {"type": "string", "minLength": 1},
        "default_step_request": {
          "oneOf": [
            {"$ref": "#/$defs/step_request"},
            {"type": "null"}
          ]
        }
      }
    },
    "candidate_a_params": {
      "type": "object",
      "required": [
        "schema_version", "eta", "kappa_c", "site_potential_id", "W_floor",
        "alpha", "beta", "gamma", "kappa_Ah", "chi_A", "zeta_A", "tau_A",
        "descriptor_backend_id", "conductance_evaluator_id"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-candidate-a-params-v1"},
        "eta": {"$ref": "#/$defs/positive_number"},
        "kappa_c": {"$ref": "#/$defs/finite_number"},
        "site_potential_id": {"type": "string", "minLength": 1},
        "W_floor": {"$ref": "#/$defs/positive_number"},
        "alpha": {"$ref": "#/$defs/finite_number"},
        "beta": {"$ref": "#/$defs/finite_number"},
        "gamma": {"$ref": "#/$defs/finite_number"},
        "kappa_Ah": {"$ref": "#/$defs/finite_number"},
        "chi_A": {"$ref": "#/$defs/finite_number"},
        "zeta_A": {"$ref": "#/$defs/finite_number"},
        "tau_A": {"$ref": "#/$defs/positive_number"},
        "descriptor_backend_id": {"type": "string", "minLength": 1},
        "conductance_evaluator_id": {"const": "curvature_disabled_G_W_v1"}
      }
    },
    "candidate_c_params": {
      "type": "object",
      "required": [
        "schema_version", "transport_id", "Lambda_C", "selector_boundary_policy_id",
        "C_ref", "kappa_M_C", "kappa_Phi_C", "eta_C", "W_C_tr",
        "W_C_tr_content_digest", "potential_evaluator_id", "tau_C", "chi_C",
        "zeta_C", "current_conditioning_policy_id", "E_H_policy_id", "E_M_policy_id"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-candidate-c-params-v1"},
        "transport_id": {"const": "C-HM-STIFFNESS-BASELINE-v1"},
        "Lambda_C": {"$ref": "#/$defs/finite_number"},
        "selector_boundary_policy_id": {"const": "strict_rank_gap_fail_closed_v1"},
        "C_ref": {"$ref": "#/$defs/positive_number"},
        "kappa_M_C": {"$ref": "#/$defs/finite_number"},
        "kappa_Phi_C": {"$ref": "#/$defs/finite_number"},
        "eta_C": {"$ref": "#/$defs/positive_number"},
        "W_C_tr": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/positive_number"}
        },
        "W_C_tr_content_digest": {"$ref": "#/$defs/digest_reference"},
        "potential_evaluator_id": {"type": "string", "minLength": 1},
        "tau_C": {"$ref": "#/$defs/nonnegative_number"},
        "chi_C": {"$ref": "#/$defs/finite_number"},
        "zeta_C": {"$ref": "#/$defs/finite_number"},
        "current_conditioning_policy_id": {"type": "string", "minLength": 1},
        "E_H_policy_id": {"const": "diag_W_C_tr_structural_hodge_v1"},
        "E_M_policy_id": {"const": "eta_C_diag_W_C_tr_mobility_v1"}
      }
    },
    "geometry_params": {
      "type": "object",
      "required": [
        "schema_version", "K4_base_digest", "reference_hodge_digest",
        "star_cover_id", "overlap_normalization_id", "candidate_adapter_id",
        "flat_sharp_solver_id", "geometry_domain_id", "kappa_H"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-geometry-profile-params-v1"},
        "K4_base_digest": {"$ref": "#/$defs/digest_reference"},
        "reference_hodge_digest": {"$ref": "#/$defs/digest_reference"},
        "star_cover_id": {"type": "string", "minLength": 1},
        "overlap_normalization_id": {"type": "string", "minLength": 1},
        "candidate_adapter_id": {"type": "string", "minLength": 1},
        "flat_sharp_solver_id": {"type": "string", "minLength": 1},
        "geometry_domain_id": {"type": "string", "minLength": 1},
        "kappa_H": {"$ref": "#/$defs/finite_number"}
      }
    },
    "ci_params": {
      "type": "object",
      "required": ["schema_version", "contraction_domain_id", "root_selector_id", "iteration_limit", "residual_norm_id", "tolerance"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-ci-params-v1"},
        "contraction_domain_id": {"type": "string", "minLength": 1},
        "root_selector_id": {"const": "unique_admitted_root_v1"},
        "iteration_limit": {"$ref": "#/$defs/positive_integer"},
        "residual_norm_id": {"type": "string", "minLength": 1},
        "tolerance": {"$ref": "#/$defs/nonnegative_number"}
      }
    },
    "os_params": {
      "type": "object",
      "required": ["schema_version", "predictor_policy_id", "corrector_policy_id", "split_residual_norm_id", "tolerance"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-os-params-v1"},
        "predictor_policy_id": {"const": "reference_geometry_predictor_v1"},
        "corrector_policy_id": {"const": "one_fresh_geometry_corrector_v1"},
        "split_residual_norm_id": {"type": "string", "minLength": 1},
        "tolerance": {"$ref": "#/$defs/nonnegative_number"}
      }
    },
    "rg2b_params": {
      "type": "object",
      "required": [
        "schema_version", "extension_evaluator_id", "approximation_policy_id",
        "error_norm_id", "error_tolerance", "containment_certificate_id",
        "iteration_limit", "failure_policy_id"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-rg2b-params-v1"},
        "extension_evaluator_id": {"type": "string", "minLength": 1},
        "approximation_policy_id": {"type": "string", "minLength": 1},
        "error_norm_id": {"type": "string", "minLength": 1},
        "error_tolerance": {"$ref": "#/$defs/nonnegative_number"},
        "containment_certificate_id": {"type": "string", "minLength": 1},
        "iteration_limit": {"$ref": "#/$defs/positive_integer"},
        "failure_policy_id": {"const": "fail_closed_on_uncertified_section_v1"}
      }
    },
    "pc_params": {
      "type": "object",
      "required": ["schema_version", "tau_PC", "radius", "carrier_norm_id", "source_envelope_id", "writer_id"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-pc-params-v1"},
        "tau_PC": {"$ref": "#/$defs/positive_number"},
        "radius": {"$ref": "#/$defs/positive_number"},
        "carrier_norm_id": {"type": "string", "minLength": 1},
        "source_envelope_id": {"type": "string", "minLength": 1},
        "writer_id": {"const": "zero_order_hold_exponential_v1"}
      }
    },
    "cipc_params": {
      "type": "object",
      "required": [
        "schema_version", "contraction_domain_id", "root_selector_id",
        "iteration_limit", "residual_norm_id", "tolerance", "tau_PC", "radius",
        "carrier_norm_id", "source_envelope_id", "writer_id", "rho_inst"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-cipc-params-v1"},
        "contraction_domain_id": {"type": "string", "minLength": 1},
        "root_selector_id": {"const": "unique_admitted_root_v1"},
        "iteration_limit": {"$ref": "#/$defs/positive_integer"},
        "residual_norm_id": {"type": "string", "minLength": 1},
        "tolerance": {"$ref": "#/$defs/nonnegative_number"},
        "tau_PC": {"$ref": "#/$defs/positive_number"},
        "radius": {"$ref": "#/$defs/positive_number"},
        "carrier_norm_id": {"type": "string", "minLength": 1},
        "source_envelope_id": {"type": "string", "minLength": 1},
        "writer_id": {"const": "zero_order_hold_exponential_v1"},
        "rho_inst": {"const": 1}
      }
    },
    "solver_policy": {
      "type": "object",
      "required": [
        "schema_version", "solver_kind", "root_selector_id", "iteration_limit",
        "conditioning_limit", "residual_norm_id", "absolute_tolerance",
        "relative_tolerance", "failure_policy_id"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-solver-policy-v1"},
        "solver_kind": {"enum": ["direct", "fixed_point", "newton"]},
        "root_selector_id": {"const": "unique_admitted_root_v1"},
        "iteration_limit": {"$ref": "#/$defs/positive_integer"},
        "conditioning_limit": {"$ref": "#/$defs/positive_number"},
        "residual_norm_id": {"type": "string", "minLength": 1},
        "absolute_tolerance": {"$ref": "#/$defs/nonnegative_number"},
        "relative_tolerance": {"$ref": "#/$defs/nonnegative_number"},
        "failure_policy_id": {"const": "fail_closed_no_fallback_v1"}
      }
    },
    "charge_policy": {
      "type": "object",
      "required": ["schema_version", "policy_id", "accumulation_order", "rounding_mode", "absolute_tolerance", "relative_tolerance", "repair_policy", "remainder_policy"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-charge-policy-v1"},
        "policy_id": {"const": "stable_pairwise_binary64_charge_v1"},
        "accumulation_order": {"const": "canonical_live_vertex_balanced_binary_tree"},
        "rounding_mode": {"const": "IEEE754_binary64_roundTiesToEven"},
        "absolute_tolerance": {"$ref": "#/$defs/nonnegative_number"},
        "relative_tolerance": {"$ref": "#/$defs/nonnegative_number"},
        "repair_policy": {"const": "never_mutate_resource"},
        "remainder_policy": {"const": "compatibility_projection_is_none"}
      }
    },
    "lifecycle_policy": {
      "type": "object",
      "required": [
        "schema_version", "migration_policy_id", "mapped_event_policy_id",
        "reset_policy_id", "rebase_policy_id", "history_policy_id",
        "receipt_policy_id", "target_readmission_policy_id"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-lifecycle-policy-v1"},
        "migration_policy_id": {"const": "typed_bidirectional_profile_migration_v1"},
        "mapped_event_policy_id": {"const": "caller_mapped_atomic_topology_event_v1"},
        "reset_policy_id": {"const": "restore_current_baseline_append_receipt_v1"},
        "rebase_policy_id": {"const": "replace_baseline_append_receipt_v1"},
        "history_policy_id": {"type": "string", "minLength": 1},
        "receipt_policy_id": {"const": "operation_delta_plus_persistent_ledger_v1"},
        "target_readmission_policy_id": {"const": "full_target_fail_closed_v1"}
      }
    },
    "resolved_params": {
      "type": "object",
      "required": ["schema_version", "common", "candidate", "realization", "geometry", "solver", "charge", "lifecycle"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-resolved-params-v1"},
        "common": {"$ref": "#/$defs/common_params"},
        "candidate": {"oneOf": [{"$ref": "#/$defs/candidate_a_params"}, {"$ref": "#/$defs/candidate_c_params"}]},
        "realization": {"oneOf": [{"$ref": "#/$defs/ci_params"}, {"$ref": "#/$defs/os_params"}, {"$ref": "#/$defs/rg2b_params"}, {"$ref": "#/$defs/pc_params"}, {"$ref": "#/$defs/cipc_params"}]},
        "geometry": {"$ref": "#/$defs/geometry_params"},
        "solver": {"$ref": "#/$defs/solver_policy"},
        "charge": {"$ref": "#/$defs/charge_policy"},
        "lifecycle": {"$ref": "#/$defs/lifecycle_policy"}
      }
    },
    "profile_identity_payload": {
      "type": "object",
      "required": [
        "schema_version", "profile_family_id", "candidate", "realization",
        "differential_backend_id", "charge_profile_id", "geometry_profile_id",
        "context_contract_id", "units_id", "gauge_id", "normalization_id",
        "domain_id", "solver_id", "lifecycle_policy_id",
        "candidate_c_transport_id", "composition_gain", "params_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-profile-identity-v1"},
        "profile_family_id": {"enum": ["A_CI", "C_CI", "A_OS", "C_OS", "A_RG2b", "C_RG2b", "A_PC", "C_PC", "A_CI_PC", "C_CI_PC"]},
        "candidate": {"enum": ["A", "C"]},
        "realization": {"enum": ["CI", "OS", "RG2b", "PC", "CI+PC"]},
        "differential_backend_id": {"type": "string", "minLength": 1},
        "charge_profile_id": {"type": "string", "minLength": 1},
        "geometry_profile_id": {"type": "string", "minLength": 1},
        "context_contract_id": {"type": "string", "minLength": 1},
        "units_id": {"type": "string", "minLength": 1},
        "gauge_id": {"type": "string", "minLength": 1},
        "normalization_id": {"type": "string", "minLength": 1},
        "domain_id": {"type": "string", "minLength": 1},
        "solver_id": {"type": "string", "minLength": 1},
        "lifecycle_policy_id": {"type": "string", "minLength": 1},
        "candidate_c_transport_id": {"enum": [null, "C-HM-STIFFNESS-BASELINE-v1"]},
        "composition_gain": {"type": ["number", "null"]},
        "params_hash": {"$ref": "#/$defs/grcv4_params_id"}
      }
    },
    "profile_template_payload": {
      "type": "object",
      "required": ["schema_version", "source_complete_profile_id", "profile_family_id", "topology_dependent_map_policy_id", "geometry_reference_policy_id"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "grcv4-profile-template-v1"},
        "source_complete_profile_id": {"$ref": "#/$defs/grcv4_profile_id"},
        "profile_family_id": {"enum": ["A_CI", "C_CI", "A_OS", "C_OS", "A_RG2b", "C_RG2b", "A_PC", "C_PC", "A_CI_PC", "C_CI_PC"]},
        "topology_dependent_map_policy_id": {"const": "preserve_old_stable_edges_seed_new_internal_edges_v1"},
        "geometry_reference_policy_id": {"const": "rebuild_reference_hodge_from_target_W_C_tr_v1"}
      }
