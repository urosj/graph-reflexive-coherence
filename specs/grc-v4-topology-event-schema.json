{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/urosj/graph-reflexive-coherence/specs/grc-v4-topology-event-schema.json",
  "title": "GRCV4 topology-event fallback binding",
  "$defs": {
    "candidate_policy": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_policy"
            },
            {
              "properties": {
                "schema_version": {
                  "const": "grcv4-history-channel-policy-v1"
                },
                "subject": {
                  "const": "candidate"
                },
                "policy_id": {
                  "const": "candidate_a_event_loss_reference_pass_v1"
                },
                "disposition": {
                  "const": "explicit_loss"
                },
                "source_history_digest": {
                  "$ref": "grc-v4-contract-schema.json#/$defs/history_content_id"
                },
                "target_initializer_id": {
                  "const": "grcv4-a-target-reference-pass-v1"
                },
                "information_loss": {
                  "const": "candidate_history_loss"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_policy"
            },
            {
              "properties": {
                "schema_version": {
                  "const": "grcv4-history-channel-policy-v1"
                },
                "subject": {
                  "const": "candidate"
                },
                "policy_id": {
                  "const": "archive_drop_candidate_history_v1"
                },
                "disposition": {
                  "const": "explicit_loss"
                },
                "source_history_digest": {
                  "$ref": "grc-v4-contract-schema.json#/$defs/history_content_id"
                },
                "target_initializer_id": {
                  "const": null
                },
                "information_loss": {
                  "const": "candidate_history_loss"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_policy"
            },
            {
              "properties": {
                "schema_version": {
                  "const": "grcv4-history-channel-policy-v1"
                },
                "subject": {
                  "const": "candidate"
                },
                "policy_id": {
                  "const": "candidate_a_target_reference_pass_initialization_log_history_v1"
                },
                "disposition": {
                  "const": "target_initializer"
                },
                "source_history_digest": {
                  "const": null
                },
                "target_initializer_id": {
                  "const": "grcv4-a-target-reference-pass-v1"
                },
                "information_loss": {
                  "const": "none"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_policy"
            },
            {
              "properties": {
                "schema_version": {
                  "const": "grcv4-history-channel-policy-v1"
                },
                "subject": {
                  "const": "candidate"
                },
                "policy_id": {
                  "const": "candidate_c_rederive_no_history_v1"
                },
                "disposition": {
                  "const": "rederived"
                },
                "source_history_digest": {
                  "const": null
                },
                "target_initializer_id": {
                  "const": null
                },
                "information_loss": {
                  "const": "none"
                }
              }
            }
          ]
        }
      ]
    },
    "carrier_policy": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_policy"
            },
            {
              "properties": {
                "schema_version": {
                  "const": "grcv4-history-channel-policy-v1"
                },
                "subject": {
                  "const": "carrier"
                },
                "policy_id": {
                  "const": "no_persistent_carrier_v1"
                },
                "disposition": {
                  "const": "not_applicable"
                },
                "source_history_digest": {
                  "const": null
                },
                "target_initializer_id": {
                  "const": null
                },
                "information_loss": {
                  "const": "none"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_policy"
            },
            {
              "properties": {
                "schema_version": {
                  "const": "grcv4-history-channel-policy-v1"
                },
                "subject": {
                  "const": "carrier"
                },
                "policy_id": {
                  "const": "canonical_zero_carrier_initialization_v1"
                },
                "disposition": {
                  "const": "target_initializer"
                },
                "source_history_digest": {
                  "const": null
                },
                "target_initializer_id": {
                  "const": "canonical_zero_carrier_v1"
                },
                "information_loss": {
                  "const": "none"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_policy"
            },
            {
              "properties": {
                "schema_version": {
                  "const": "grcv4-history-channel-policy-v1"
                },
                "subject": {
                  "const": "carrier"
                },
                "policy_id": {
                  "const": "archive_drop_carrier_history_v1"
                },
                "disposition": {
                  "const": "explicit_loss"
                },
                "source_history_digest": {
                  "$ref": "grc-v4-contract-schema.json#/$defs/history_content_id"
                },
                "target_initializer_id": {
                  "const": null
                },
                "information_loss": {
                  "const": "carrier_history_loss"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_policy"
            },
            {
              "properties": {
                "schema_version": {
                  "const": "grcv4-history-channel-policy-v1"
                },
                "subject": {
                  "const": "carrier"
                },
                "policy_id": {
                  "const": "event_loss_and_zero_target_carrier_v1"
                },
                "disposition": {
                  "const": "whole_carrier_reset"
                },
                "source_history_digest": {
                  "$ref": "grc-v4-contract-schema.json#/$defs/history_content_id"
                },
                "target_initializer_id": {
                  "const": "canonical_zero_carrier_v1"
                },
                "information_loss": {
                  "const": "carrier_history_loss"
                }
              }
            }
          ]
        }
      ]
    },
    "history_policy": {
      "allOf": [
        {
          "$ref": "grc-v4-contract-schema.json#/$defs/history_bundle_policy"
        },
        {
          "properties": {
            "candidate": {
              "$ref": "#/$defs/candidate_policy"
            },
            "carrier": {
              "$ref": "#/$defs/carrier_policy"
            }
          }
        }
      ]
    },
    "event_request": {
      "allOf": [
        {
          "$ref": "grc-v4-contract-schema.json#/$defs/mapped_topology_event_request"
        },
        {
          "properties": {
            "history_policy": {
              "$ref": "#/$defs/history_policy"
            }
          }
        }
      ]
    },
    "candidate_receipt": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_receipt"
            },
            {
              "properties": {
                "subject": {
                  "const": "candidate"
                },
                "disposition": {
                  "const": "explicit_loss"
                },
                "source_history_digest": {
                  "$ref": "grc-v4-contract-schema.json#/$defs/history_content_id"
                },
                "information_loss": {
                  "const": "candidate_history_loss"
                },
                "target_history_digest": {
                  "$ref": "grc-v4-contract-schema.json#/$defs/history_content_id"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_receipt"
            },
            {
              "properties": {
                "subject": {
                  "const": "candidate"
                },
                "disposition": {
                  "const": "explicit_loss"
                },
                "source_history_digest": {
                  "$ref": "grc-v4-contract-schema.json#/$defs/history_content_id"
                },
                "information_loss": {
                  "const": "candidate_history_loss"
                },
                "target_history_digest": {
                  "type": "null"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_receipt"
            },
            {
              "properties": {
                "subject": {
                  "const": "candidate"
                },
                "disposition": {
                  "const": "target_initializer"
                },
                "source_history_digest": {
                  "const": null
                },
                "information_loss": {
                  "const": "none"
                },
                "target_history_digest": {
                  "$ref": "grc-v4-contract-schema.json#/$defs/history_content_id"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_receipt"
            },
            {
              "properties": {
                "subject": {
                  "const": "candidate"
                },
                "disposition": {
                  "const": "rederived"
                },
                "source_history_digest": {
                  "const": null
                },
                "information_loss": {
                  "const": "none"
                },
                "target_history_digest": {
                  "type": "null"
                }
              }
            }
          ]
        }
      ]
    },
    "carrier_receipt": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_receipt"
            },
            {
              "properties": {
                "subject": {
                  "const": "carrier"
                },
                "disposition": {
                  "const": "not_applicable"
                },
                "source_history_digest": {
                  "const": null
                },
                "information_loss": {
                  "const": "none"
                },
                "target_history_digest": {
                  "type": "null"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_receipt"
            },
            {
              "properties": {
                "subject": {
                  "const": "carrier"
                },
                "disposition": {
                  "const": "target_initializer"
                },
                "source_history_digest": {
                  "const": null
                },
                "information_loss": {
                  "const": "none"
                },
                "target_history_digest": {
                  "$ref": "grc-v4-contract-schema.json#/$defs/history_content_id"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_receipt"
            },
            {
              "properties": {
                "subject": {
                  "const": "carrier"
                },
                "disposition": {
                  "const": "explicit_loss"
                },
                "source_history_digest": {
                  "$ref": "grc-v4-contract-schema.json#/$defs/history_content_id"
                },
                "information_loss": {
                  "const": "carrier_history_loss"
                },
                "target_history_digest": {
                  "type": "null"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_channel_receipt"
            },
            {
              "properties": {
                "subject": {
                  "const": "carrier"
                },
                "disposition": {
                  "const": "whole_carrier_reset"
                },
                "source_history_digest": {
                  "$ref": "grc-v4-contract-schema.json#/$defs/history_content_id"
                },
                "information_loss": {
                  "const": "carrier_history_loss"
                },
                "target_history_digest": {
                  "$ref": "grc-v4-contract-schema.json#/$defs/history_content_id"
                }
              }
            }
          ]
        }
      ]
    },
    "event_receipt_payload": {
      "type": "object",
      "required": [
        "schema_version",
        "core",
        "event_id",
        "history",
        "initializer_pair_id"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "grcv4-topology-event-receipt-v2"
        },
        "core": {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/receipt_core"
            },
            {
              "properties": {
                "source_model_identity": {
                  "$ref": "grc-v4-contract-schema.json#/$defs/grcv4_profile_id"
                },
                "target_model_identity": {
                  "$ref": "grc-v4-contract-schema.json#/$defs/grcv4_profile_id"
                },
                "information_losses": {
                  "enum": [
                    [],
                    [
                      "candidate_history_loss"
                    ],
                    [
                      "carrier_history_loss"
                    ],
                    [
                      "candidate_history_loss",
                      "carrier_history_loss"
                    ]
                  ]
                }
              }
            }
          ]
        },
        "event_id": {
          "$ref": "grc-v4-contract-schema.json#/$defs/event_id"
        },
        "history": {
          "allOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/history_bundle_receipt"
            },
            {
              "properties": {
                "candidate": {
                  "$ref": "#/$defs/candidate_receipt"
                },
                "carrier": {
                  "$ref": "#/$defs/carrier_receipt"
                }
              }
            }
          ]
        },
        "initializer_pair_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^grcv4-a-reference-pass-pair-sha256:[0-9a-f]{64}$"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "history": {
                "properties": {
                  "candidate": {
                    "properties": {
                      "target_history_digest": {
                        "type": "null"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "initializer_pair_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "initializer_pair_id": {
                "type": "string"
              }
            }
          }
        }
      ],
      "description": "Pair presence, channel losses and endpoint linkage require semantic validation; this is not execution evidence."
    },
    "legacy_event_request": {
      "allOf": [
        {
          "$ref": "grc-v4-contract-schema.json#/$defs/mapped_topology_event_request"
        },
        {
          "properties": {
            "history_policy": {
              "properties": {
                "candidate": {
                  "properties": {
                    "policy_id": {
                      "enum": [
                        "candidate_c_no_independent_history_v1",
                        "candidate_c_rederive_no_history_v1"
                      ]
                    },
                    "disposition": {
                      "const": "rederived"
                    },
                    "source_history_digest": {
                      "type": "null"
                    },
                    "target_initializer_id": {
                      "type": "null"
                    },
                    "information_loss": {
                      "const": "none"
                    }
                  }
                },
                "carrier": {
                  "properties": {
                    "policy_id": {
                      "enum": [
                        "no_persistent_carrier_v1",
                        "carrier_not_applicable_v1"
                      ]
                    },
                    "disposition": {
                      "const": "not_applicable"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "transition_record": {
      "type": "object",
      "required": [
        "commit_id",
        "request",
        "source",
        "source_reset",
        "target",
        "target_reset",
        "initializer_pair"
      ],
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "grc-v4-contract-schema.json#/$defs/commit_id"
        },
        "request": {
          "oneOf": [
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/migration_request"
            },
            {
              "$ref": "grc-v4-contract-schema.json#/$defs/mapped_topology_event_request"
            }
          ]
        },
        "source": {
          "$ref": "grc-v4-contract-schema.json#/$defs/scientific_state_payload"
        },
        "source_reset": {
          "$ref": "grc-v4-contract-schema.json#/$defs/grcv4_reset_payload"
        },
        "target": {
          "$ref": "grc-v4-contract-schema.json#/$defs/scientific_state_payload"
        },
        "target_reset": {
          "$ref": "grc-v4-contract-schema.json#/$defs/grcv4_reset_payload"
        },
        "initializer_pair": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "grc-v4-a-initializer-schema.json#/$defs/pair_record"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "request": {
                "properties": {
                  "schema_version": {
                    "const": "grcv4-mapped-topology-event-request-v1"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "request": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/event_request"
                  },
                  {
                    "$ref": "#/$defs/legacy_event_request"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "request": {
                      "properties": {
                        "history_policy": {
                          "properties": {
                            "candidate": {
                              "properties": {
                                "target_initializer_id": {
                                  "const": "grcv4-a-target-reference-pass-v1"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "initializer_pair": {
                      "$ref": "grc-v4-a-initializer-schema.json#/$defs/pair_record"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "initializer_pair": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "request": {
                      "properties": {
                        "history_policy": {
                          "properties": {
                            "candidate": {
                              "properties": {
                                "source_history_digest": {
                                  "type": "null"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "then": {
                  "allOf": [
                    {
                      "properties": {
                        "source": {
                          "properties": {
                            "authoritative": {
                              "properties": {
                                "W_A": {
                                  "type": "null"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "properties": {
                        "source_reset": {
                          "properties": {
                            "authoritative": {
                              "properties": {
                                "W_A": {
                                  "type": "null"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "else": {
                  "allOf": [
                    {
                      "properties": {
                        "source": {
                          "properties": {
                            "authoritative": {
                              "properties": {
                                "W_A": {
                                  "type": "array"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "properties": {
                        "source_reset": {
                          "properties": {
                            "authoritative": {
                              "properties": {
                                "W_A": {
                                  "type": "array"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "request": {
                      "properties": {
                        "history_policy": {
                          "properties": {
                            "candidate": {
                              "properties": {
                                "target_initializer_id": {
                                  "type": "null"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "then": {
                  "allOf": [
                    {
                      "properties": {
                        "target": {
                          "properties": {
                            "authoritative": {
                              "properties": {
                                "W_A": {
                                  "type": "null"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "properties": {
                        "target_reset": {
                          "properties": {
                            "authoritative": {
                              "properties": {
                                "W_A": {
                                  "type": "null"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "else": {
                  "allOf": [
                    {
                      "properties": {
                        "target": {
                          "properties": {
                            "authoritative": {
                              "properties": {
                                "W_A": {
                                  "type": "array"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "properties": {
                        "target_reset": {
                          "properties": {
                            "authoritative": {
                              "properties": {
                                "W_A": {
                                  "type": "array"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "request": {
                      "properties": {
                        "history_policy": {
                          "properties": {
                            "carrier": {
                              "properties": {
                                "source_history_digest": {
                                  "type": "null"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "then": {
                  "allOf": [
                    {
                      "properties": {
                        "source": {
                          "properties": {
                            "authoritative": {
                              "properties": {
                                "Z_4": {
                                  "type": "null"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "properties": {
                        "source_reset": {
                          "properties": {
                            "authoritative": {
                              "properties": {
                                "Z_4": {
                                  "type": "null"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "else": {
                  "allOf": [
                    {
                      "properties": {
                        "source": {
                          "properties": {
                            "authoritative": {
                              "properties": {
                                "Z_4": {
                                  "type": "array"
                                }
                              }
                            }
                          }
                        }
