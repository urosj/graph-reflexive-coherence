    "primary_metric": "euclidean_on_fixed_total_zero_sum_C_tangent",
    "secondary_metrics": [
      "reference_C_scale_normalized_euclidean",
      "induced_W_observation_norm",
      "joint_C_W_block_normalized_observation_norm"
    ],
    "projector_policy": "fixed_reference_projector",
    "projector_reference": "accepted_candidate_k0_complete_step_C_jacobian",
    "projector_recomputation_to_follow_candidate_allowed": false,
    "state_dependent_transport_allowed": false
  },
  "branch_relation": {
