{
  "schema_version": "b2_i2_constructibility_schema_contract_v1",
  "source_gate": {
    "acceptance_anchor_path": "experiments/2026-08-B2-GR-grc9v3-retention-mediation-constructibility/outputs/gates/b2_i1_acceptance_anchor.json",
    "required_acceptance_status": "accepted",
    "required_closeout_rung": "B2-C0",
    "required_ready_for_iteration_2": true
  },
  "provenance_classes": {
    "evidence_classes": {
      "native_runtime_reached": "positive_eligible_subject_to_all_row_gates",
      "synthetic_valid": "diagnostic_only",
      "reduced_model": "diagnostic_only",
      "derived_report": "diagnostic_only"
    },
    "positive_eligible": [
      "native_spontaneous",
      "runtime_realized_from_upstream_preparation"
    ],
    "diagnostic_only": [
      "synthetic_internal_state",
      "synthetic_counterfactual_match",
      "reduced_frozen_W",
      "derived_report_only"
    ]
  },
  "primary_lane": {
    "lane_id": "unchanged_GRC9V3_fixed_topology_event_free_same_stratum",
    "fixed_topology": true,
    "event_free": true,
    "same_causal_stratum_required_for_derivative_or_projector_evidence": true,
    "load_bearing_clipping_allowed": false,
    "load_bearing_budget_projection_allowed": false,
    "eventful_history_role": "separate_nonupgrading_eventful_history_persistence"
  },
  "search_envelope": {
    "source_branch_rule": "all_48_accepted_B1_branches_without_ranking_or_symmetry_reduction",
    "source_fixture_ids": ["F1", "F2", "F3"],
    "source_branch_count": 48,
    "evaluation_topology_rule": "exact_source_branch_topology_and_port_orientation",
    "evaluation_parameter_rule": "exact_source_B1_parameter_vector",
    "parameter_continuation_at_evaluation_allowed": false,
    "preparation_driver_families": [
      {
        "driver_id": "native_spontaneous_no_driver",
        "driver_class": "none",
        "positive_eligible": true
      },
      {
        "driver_id": "budget_respecting_zero_sum_C_pair_pulse",
        "driver_class": "bounded_budget_respecting_C_perturbation",
        "direction_rule": "every_oriented_existing_edge_in_source_topology",
        "amplitude_fraction_of_total_C": [0.0001, 0.001, 0.01],
        "positive_eligible_subject_to_driver_carrier_separation": true
      },
      {
        "driver_id": "temporary_parameter_history_after_C_pair_pulse",
        "driver_class": "preregistered_runtime_parameter_history",
        "pulse_driver_id": "budget_respecting_zero_sum_C_pair_pulse",
        "pulse_amplitude_source": "search_envelope.preparation_driver_families[1].amplitude_fraction_of_total_C",
        "pulse_direction_source": "search_envelope.preparation_driver_families[1].direction_rule",
        "parameter_variants": {
          "dt_multiplier": [0.5, 1.5],
          "eta_multiplier": [0.5, 2.0]
        },
        "history_lengths_native_steps": [1, 2, 4, 8],
        "evaluation_parameters_restored_before_k0": true,
        "positive_eligible_subject_to_driver_carrier_separation": true
      }
    ],
    "unavailable_driver_classes": [
      {
        "driver_id": "native_exposed_boundary_or_external_input",
        "status": "not_exposed_by_current_GRC9V3_step_API",
        "rung_effect": "outside_envelope_not_negative_evidence"
      }
    ],
    "history_lengths_native_steps": [1, 2, 4, 8],
    "persistence_horizons_native_steps": [1, 2, 4, 8, 16, 32],
    "seed_rule": "consume_each_source_branch_rng_state_without_reseeding_or_post_hoc_seed_selection",
    "maximum_discovery_rows": 9648,
    "maximum_discovery_native_steps": 50000,
    "maximum_fresh_process_confirmations": 9600,
    "search_algorithm": "deterministic_lexicographic_exhaustive_grid",
    "stopping_rule": "complete_grid_or_budget_exhaustion_with_all_unexecuted_rows_search_unresolved",
    "deduplication_rule": "same_runtime_state_digest_same_lineage_same_provenance_is_duplicate_but_alias_rows_remain_accounted",
    "symmetry_rule": "execute_all_48_branches_and_use_symmetry_orbits_for_characterization_only",
    "discovery_confirmation_split": "discover_then_freeze_history_then_fresh_process_reconstruct_before_I4_acceptance"
  },
  "thresholds": {
    "declared_before_positive_search": true,
    "inherited_replay_block_tolerances": {
      "C": {"absolute": 1e-10, "relative": 1e-9},
      "W": {"absolute": 1e-10, "relative": 1e-9},
      "J": {"absolute": 1e-10, "relative": 1e-9},
      "Phi": {"absolute": 1e-9, "relative": 1e-8},
      "G": {"absolute": 1e-9, "relative": 1e-8},
      "budget": {"absolute": 1e-10, "relative": 1e-9},
      "identity": {"absolute": 1e-9, "relative": 1e-8}
    },
    "row_numerical_uncertainty_rule": "maximum_of_codec_replay_finite_difference_basis_covariance_and_symmetry_covariance_errors",
    "minimum_positive_margin_rule": "strictly_greater_than_maximum_of_1e-10_and_10_times_row_numerical_uncertainty",
    "carrier_separation_rule": "strictly_greater_than_maximum_of_1e-10_and_10_times_row_numerical_uncertainty",
    "noncarrier_match_rule": "each_block_at_or_below_maximum_of_inherited_block_tolerance_and_10_times_row_numerical_uncertainty",
    "slow_multiplier_magnitude_floor": 0.9,
    "spectral_convergence_error_maximum": 0.01,
    "slow_cluster_isolation_rule": "strictly_greater_than_maximum_of_1e-6_and_10_times_cluster_uncertainty_bound",
    "cluster_condition_number_maximum": 100000000.0,
    "persistence_ratio_floor": 0.9,
    "persistence_ratio_required_horizons": [8, 16, 32],
    "probe_amplitude_fraction_of_total_C": [0.0001, 0.001, 0.01],
    "probe_parameter_relative_amplitudes": [-0.1, -0.05, -0.01, 0.01, 0.05, 0.1],
    "zero_margin_witness_allowed": false,
    "threshold_equality_witness_allowed": false,
    "post_hoc_threshold_change_allowed": false
  },
  "carrier_definitions": [
    {
      "carrier_definition_id": "C_ZERO_SUM_V1",
      "carrier_class": "C_sector",
      "state_fields": ["dynamics.state.nodes[*].coherence"],
      "metric": "euclidean_on_fixed_total_zero_sum_C_tangent",
      "projector": "orthogonal_projection_off_all_ones_conservation_direction",
      "complement": "complete_admitted_state_except_projected_zero_sum_C_component",
      "independent_causal_coordinate": true,
      "temporal_observation_map": "identity_on_admitted_complete_step_C_state",
      "direct_C_driver_overlap_effect": "authored_component_cannot_count_as_native_write_or_GRR3_carrier"
    },
    {
      "carrier_definition_id": "W_EDGE_CONDUCTANCE_OBSERVATION_V1",
      "carrier_class": "W_sector",
      "state_fields": ["dynamics.state.port_edges[*].conductance"],
      "metric": "euclidean_on_sorted_fixed_topology_edge_conductance_vector",
      "projector": "identity_on_sorted_edge_conductance_observation_block",
      "complement": "complete_admitted_state_except_W_observation_block",
      "independent_causal_coordinate": false,
      "temporal_observation_map": "D_C_W_lift_of_admitted_complete_step_C_slow_subspace",
      "direct_C_driver_overlap_effect": "eligible_only_for_runtime_generated_W_component_after_driver_exhaustion"
    },
    {
      "carrier_definition_id": "JOINT_C_W_BLOCK_V1",
      "carrier_class": "joint_C_W_sector",
      "state_fields": [
        "dynamics.state.nodes[*].coherence",
        "dynamics.state.port_edges[*].conductance"
      ],
      "metric": "equal_weight_block_normalized_euclidean_C_zero_sum_plus_W_observation",
      "projector": "direct_sum_of_C_ZERO_SUM_V1_and_W_EDGE_CONDUCTANCE_OBSERVATION_V1",
      "complement": "complete_admitted_state_except_joint_C_W_block",
      "independent_causal_coordinate": false,
      "temporal_observation_map": "C_identity_plus_D_C_W_lift_of_same_admitted_slow_subspace",
      "direct_C_driver_overlap_effect": "authored_C_component_excluded_and_runtime_generated_joint_component_required"
    }
  ],
  "temporal_operator": {
    "temporal_operator_id": "B1_GRV3_ADMITTED_COMPLETE_STEP_C_OPERATOR_V1",
    "domain": "fixed_total_zero_sum_C_tangent_on_admitted_smooth_complete_step_stratum",
    "transition": "complete_unchanged_GRC9V3_step_with_W_J_and_cached_surfaces_reconstructed_in_native_order",
