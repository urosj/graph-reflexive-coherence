    "fixed_configuration_sheet_estimator": "preregistered_local_solution_seed_panel_plus_SVD_tangent_estimate",
    "local_seed_count_minimum": 8,
    "local_seed_radius_rule": "minimum_of_0.1_times_candidate_displacement_and_positive_stratum_margin_half_width",
    "svd_rank_threshold_rule": "maximum_of_10_times_solver_residual_and_10_times_row_numerical_uncertainty",
    "symmetry_quotient": "declared_graph_automorphism_orbit_from_B1",
    "parameter_continuation_tangent_recorded_separately": true,
    "primary_positive_class": "same_branch_transverse_retention_candidate",
    "classes": [
      "same_branch_transverse_retention_candidate",
      "branch_tangent_neutral_displacement",
      "history_induced_branch_relocation",
      "branch_switch",
      "unresolved_branch_relation"
    ]
  },
  "probe_contract": {
    "difference_in_differences_required": true,
    "zero_probe_baseline_required": true,
    "zero_probe_is_core_passive_null": false,
    "pair_provenance_positive_eligible": [
