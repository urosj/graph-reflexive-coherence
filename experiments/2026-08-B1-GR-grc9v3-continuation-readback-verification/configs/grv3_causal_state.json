    "round_trip_required": true,
    "reached_state_canonicalization_required": true,
    "transition_commutation_required": true,
    "physical_blocks_compared_for_reductions": ["C", "W", "J"]
  },
  "grv3_b": {
    "finite_difference_method": "two_sided_central_only_within_one_causal_stratum",
    "finite_difference_steps": [0.0001, 0.00005, 0.000025],
    "minimum_positive_stratum_margin": 1e-12,
    "current_zero_band": 1e-10,
    "require_same_pre_step_signature": true,
    "require_same_post_step_signature": true,
    "require_same_runtime_path": true,
    "blocked_column_policy": "do_not_emit_classical_derivative_or_spectrum",
