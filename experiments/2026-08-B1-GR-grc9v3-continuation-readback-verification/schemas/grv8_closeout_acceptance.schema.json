{
  "$id": "b1/grv8_closeout_acceptance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "B1_L_execution_authorized": {"const": false},
    "acceptance_role": {"const": "experiment_owner"},
    "acceptance_signature_or_ref": {"type": "string", "minLength": 1},
    "acceptance_status": {"const": "accepted"},
    "acceptance_timestamp": {"type": "string", "minLength": 1},
    "accepted_by": {"type": "string", "minLength": 1},
    "accepted_grv8_anchor_path": {"const": "outputs/gates/grv8_acceptance_anchor.json"},
    "accepted_grv8_anchor_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "assigned_closeout_rung": {"const": "GRV-C6"},
    "evidence_bundle_path": {"const": "outputs/evidence_bundle_manifest.json"},
    "evidence_bundle_payload_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "evidence_bundle_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "gate_id": {"const": "GRV8"},
    "next_route_handoff_path": {"const": "outputs/continuation_readback_next_route_handoff.json"},
    "next_route_handoff_payload_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "next_route_handoff_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "receipt_payload_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "result_revision": {"pattern": "^[0-9a-f]{40}$"},
    "review_method": {"type": "string", "minLength": 1},
    "runtime_change_authorized": {"const": false},
    "successor_specification_path": {"const": "implementation/GRC9V3ContinuationReadBackVerificationSpecification_EvidenceGrounded_v1.md"},
    "successor_specification_sha256": {"pattern": "^[0-9a-f]{64}$"}
  },
  "required": [
    "gate_id",
    "result_revision",
    "receipt_payload_sha256",
    "accepted_by",
    "acceptance_role",
    "review_method",
    "acceptance_timestamp",
    "acceptance_status",
    "acceptance_signature_or_ref",
    "assigned_closeout_rung",
    "accepted_grv8_anchor_path",
    "accepted_grv8_anchor_sha256",
    "evidence_bundle_path",
    "evidence_bundle_sha256",
    "evidence_bundle_payload_sha256",
    "successor_specification_path",
    "successor_specification_sha256",
    "next_route_handoff_path",
    "next_route_handoff_sha256",
    "next_route_handoff_payload_sha256",
    "runtime_change_authorized",
    "B1_L_execution_authorized"
  ],
  "type": "object"
}
