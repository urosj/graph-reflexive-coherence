{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "b1/grv8_causal_role.schema.json",
  "type": "object",
  "required": ["gate_id", "rows", "summary", "highest_supported_claim", "blocked_claims"],
  "properties": {
    "gate_id": {"const": "GRV8"},
    "rows": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": [
          "role_id",
          "status",
          "classification_scope",
          "maximum_supported_claim",
          "blocked_claims",
          "accepted_evidence_records"
        ],
        "properties": {
          "role_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "accepted_evidence_records": {"type": "array", "minItems": 1}
        }
      }
    },
    "summary": {"type": "object"},
    "highest_supported_claim": {"type": "string"},
    "blocked_claims": {"type": "array"}
  }
}
