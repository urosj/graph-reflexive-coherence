{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "b1/grv8_traceability.schema.json",
  "$defs": {
    "traceabilityRow": {
      "type": "object",
      "required": [
        "traceability_row_id",
        "controlling_source_row",
        "source_row",
        "source_row_adjusted",
        "source_row_adjustment",
        "claim_ids",
        "debt_ids",
        "assumption_ids",
        "assumption_statuses",
        "result_dispositions",
        "primary_routes",
        "evidence_refs",
        "accepted_evidence_records"
      ],
      "properties": {
        "traceability_row_id": {"pattern": "^TR-[0-9]{2}$"},
        "controlling_source_row": {"type": "object"},
        "source_row": {"type": "object"},
        "source_row_adjusted": {"type": "boolean"},
        "source_row_adjustment": {"type": ["object", "null"]},
        "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
        "debt_ids": {"type": "array", "uniqueItems": true},
        "assumption_ids": {"type": "array", "uniqueItems": true},
        "assumption_statuses": {"type": "object"},
        "result_dispositions": {"type": "object"},
        "primary_routes": {"type": "array", "minItems": 1, "uniqueItems": true},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true},
        "accepted_evidence_records": {"type": "array", "minItems": 1, "uniqueItems": true}
      }
    }
  },
  "type": "object",
  "required": [
    "gate_id",
    "rows",
    "controlling_source_matrix_preserved",
    "source_row_adjustment_count",
    "accepted_evidence_records_deduplicated",
    "results_pending",
    "highest_supported_claim",
    "blocked_claims"
  ],
  "properties": {
    "gate_id": {"const": "GRV8"},
    "rows": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {"$ref": "#/$defs/traceabilityRow"}
    },
    "controlling_source_matrix_preserved": {"const": true},
    "source_row_adjustment_count": {"const": 1},
    "accepted_evidence_records_deduplicated": {"const": true},
    "results_pending": {"const": false},
    "highest_supported_claim": {"type": "string"},
    "blocked_claims": {"type": "array"}
  }
}
