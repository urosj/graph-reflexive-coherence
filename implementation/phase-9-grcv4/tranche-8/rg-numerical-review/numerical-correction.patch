+def interval_input(value, size, label):
+    require(
+        getattr(value, "rows", None) == size and getattr(value, "cols", None) == 1,
+        f"incomplete {label} enclosure",
+    )
+    value = value.copy()
+    require(
+        all(endpoint(z, 0) <= endpoint(z, 1) for z in value),
+        f"invalid {label} enclosure",
+    )
+    return value
+
+
+def checked_model(model):
+    """Bind consumed arrays to the graph used by the independent certificate."""
+    require(model.params == PARAMS, "candidate/parameter binding")
+    reference = StagedRows(model.nodes, model.edges, PARAMS)
+    require(model.index == reference.index, "graph index binding")
+    for name in ("B", "D", "I", "mask"):
+        expected = getattr(reference, name)
+        actual = finite_array(getattr(model, name), expected.shape)
+        require(np.array_equal(actual, expected), f"graph {name} binding")
+
+
+def physical_input(c, w):
+    require(
+        all(0 <= endpoint(z, 0) <= endpoint(z, 1) < 4 for z in c),
+        "physical query outside resource agreement chart",
+    )
+    if w is not None:
+        require(all(endpoint(z, 0) > 0 for z in w), "positive A history required")
+        require(
+            all(
+                Q(-5, 8)
+                < endpoint(number(rg.SCALE) * IV.ln(z), 0)
+                <= endpoint(number(rg.SCALE) * IV.ln(z), 1)
+                < Q(5, 8)
+                for z in w
+            ),
+            "physical query outside history agreement chart",
+        )
+
+
