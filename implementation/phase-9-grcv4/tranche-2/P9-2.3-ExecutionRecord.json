  "implemented_boundaries": [
    "wire syntax/shape failures are exceptions before semantic admission",
    "negative duration returns an exact noncommitting FailureReceipt",
    "strict request constructors reject invalid duration and detach nested input",
    "configuration and exact canonical reconstruction routes remain distinct",
    "nonzero binary64 underflow and trailing-newline identity aliases reject",
    "migration declarations are typed but not scientifically admitted",
    "harness/snapshot/pickle and GRC9 request schemas are excluded from this production request transport"
  ],
