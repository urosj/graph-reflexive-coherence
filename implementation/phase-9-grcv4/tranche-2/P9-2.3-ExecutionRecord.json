  "audit_dispositions": [
    {
      "item": "Strict request / migration declaration is not full admission",
      "action": "Strengthened current-consumer/no-authority tests; actual state-bearing consumer invariants assigned to P9-2.4/2.5/2.6, P9-4.4/4.5/4.7a and Tranche 7; no premature consumer implementation."
    },
    {
      "item": "Default encoding",
      "action": "Documented explicit configuration and exact-JCS routes; isolated tests disprove subnormal exclusion. Default accepts exponent and decimal finite tokens; oversized integer-shaped tokens require exact-canonical interpretation when restoring JCS. No fallback or default change."
    },
    {
      "item": "Receipt authentication / full request identity / causal binding",
      "action": "Content-only docstring and tests for arbitrary grammar-valid source labels, distinct requests sharing receipts, and rehashed stage/code labels without an operation trace. Frozen preimage unchanged; real-state/operation/replay binding remains with lifecycle owners."
    },
    {
      "item": "Failure taxonomy",
      "action": "Exact enum-parity regression and test that only admission/invalid_duration is emitted by this prefix; later owner must distinguish rejected operation from valid_root solver and returned delta from persistent ledger."
    },
    {
      "item": "Exact dependencies missing in external audit",
      "action": "All original 32 bindings verified before edits; exact bound profile/state/assets used in the new checkout run with rfc8785 0.1.4 and production jsonschema. Clean wheel/sdist exercise actual installed assets. Prior qualified isolated result and current checkout result remain separate."
    },
    {
      "item": "Numeric and ownership boundaries",
      "action": "Exact underflow midpoint and int/float JCS regressions added; existing opaque-context, malformed-wire, immutable-ownership, environment-failure and pinned-identity grammar checks retained."
    }
  ]
